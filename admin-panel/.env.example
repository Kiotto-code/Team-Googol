# Base URL for REST API requests. Include the protocol, host, and the `/api/v1/admin` prefix.
# Example (local FastAPI dev server): http://localhost:8000/api/v1/admin
VITE_API_BASE_URL="http://localhost:8000/api/v1/admin"

# WebSocket endpoint for live box events. Use ws:// or wss:// depending on TLS.
# The token query string is appended automatically.
# Example: ws://localhost:8000/api/v1/admin/ws/boxes
VITE_WS_URL="ws://localhost:8000/api/v1/admin/ws/boxes"

# Default timezone used for date/time formatting in the UI.
# Supported values: Asia/Kuala_Lumpur, UTC
VITE_DEFAULT_TZ="Asia/Kuala_Lumpur"

# Where to persist auth tokens. Choose "local" for localStorage or "session" for sessionStorage.
VITE_AUTH_STORAGE="local"
