# Environment template for the admin SPA served from /admin-panel
# Copy this file to admin-panel/.env (or admin-panel/.env.local) and adjust values.

# Base URL for REST requests issued by the admin SPA.
# Use a fully qualified URL when the frontend is hosted on a different domain.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/admin

# Base URL (protocol + host) used to build websocket endpoints.
# Leave empty to derive the value from the active browser location.
VITE_WS_URL=ws://127.0.0.1:8000

# Default timezone for new admin sessions (must be an IANA TZ identifier).
# Leave empty to use the browser's local timezone.
VITE_DEFAULT_TZ=UTC
